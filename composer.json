{
  "name": "clubstudio/craft",
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "craftcms/ckeditor": "^5.6.1",
    "craftcms/cms": "^5.12.2",
    "nystudio107/craft-retour": "^5.0.12",
    "nystudio107/craft-seomatic": "^5.1.18",
    "nystudio107/craft-vite": "^5.0.0",
    "verbb/formie": "^4.1.0",
    "verbb/navigation": "^4.1.1",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "php-http/discovery": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\"",
      "@php -r \"file_exists('.mcp.json') || !getenv('DDEV_PRIMARY_URL') || file_put_contents('.mcp.json', json_encode(['mcpServers' => ['craft' => ['type' => 'http', 'url' => getenv('DDEV_PRIMARY_URL') . '/admin/mcp/auth']]], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL);\"",
      "@php -r \"unlink('composer.json');\"",
      "@php -r \"rename('composer.json.default', 'composer.json');\"",
      "@php -r \"unlink('README.md');\"",
      "@php -r \"rename('README.md.default', 'README.md');\"",
      "@php -r \"file_exists('AGENTS.md') && unlink('AGENTS.md');\""
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
