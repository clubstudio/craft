{#
  Testimonial: a quote, with the person, their company and their photo.

  Inputs:
  - quote: the quote, as rich text
  - person: who said it
  - company: where they work
  - image: their photo, shown as decoration
  - class: extra classes for the <figure>
#}
{% set data = {
    quote: null,
    person: '',
    company: '',
    image: null,
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

<figure {{ attr({ class: classes.combine(null, data.class)|string ?: false }) }}>
    <figcaption class="flex items-center gap-6 in-[.text-center]:justify-center in-[.text-right]:justify-end">
        {% if data.image %}
            <div class="relative w-16 shrink-0">
                {% include '_components/image' with {
                    image: data.image,
                    alt: '',
                    transformKey: 'avatar',
                    aspectRatio: 'square',
                    class: 'w-full h-full object-cover',
                } only %}
            </div>
        {% endif %}
        <div class="flex flex-col">
            <strong>{{ data.person }}</strong>
            {% if data.company|length %}
                <small>{{ data.company }}</small>
            {% endif %}
        </div>
    </figcaption>
    <blockquote class="mt-3">
        {{ data.quote }}
    </blockquote>
</figure>
