{#
  Rich Text: rich text from a CKEditor field, styled by .body-copy in site.css. Nothing renders without a body.

  Inputs:
  - body: the rich text
  - class: extra classes for the wrapper
#}
{% set data = {
    body: null,
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% if data.body|length %}
    <div class="{{ classes.combine('body-copy', data.class) }}">
        {{ data.body }}
    </div>
{% endif %}
