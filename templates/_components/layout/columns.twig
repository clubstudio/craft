{#
  Columns (layout): a grid of columns, stacked on mobiles. Embed it and fill the content block with one
  element per column.

  Inputs:
  - layout: the relative width of each column: 11, 12, 21, 13, 31 or 111 (11)
  - verticalAlignment: top, middle or bottom (top)
  - class: extra classes for the grid
#}
{% set data = {
    layout: '11',
    verticalAlignment: 'top',
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

<div class="{{ classes.combine(['grid gap-6', classes.columnLayout(data.layout ?: '11'), classes.verticalAlignment(data.verticalAlignment ?: 'top')], data.class) }}">
    {% block content '' %}
</div>
