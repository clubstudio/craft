{% set data = {
    image: null,
    alt: null,
    caption: null,
    transformKey: null,
    aspectRatio: null,
    class: null,
    loading: 'lazy',
    decoding: 'async',
    attributes: {},
}|merge(_context) %}

{% import '_macros/classes' as classes %}
{% import '_macros/media' as media %}

{% set transforms = craft.app.config.custom.transforms %}
{# Use the key, or the nearest parent key that exists (section:narrow:columns:2 → section:narrow:columns → section:narrow), then default. #}
{% set requestedKey = data.transformKey ?? 'default' %}
{% set parts = requestedKey|split(':') %}
{% set transformKey = 'default' %}
{% for length in parts|length..1 %}
    {% set candidate = parts|slice(0, length)|join(':') %}
    {% if transformKey == 'default' and attribute(transforms, candidate) is defined %}
        {% set transformKey = candidate %}
    {% endif %}
{% endfor %}
{% set transformInfo = attribute(transforms, transformKey) %}
{% set aspectRatio = media.aspectRatio(data.aspectRatio, data.image)|string|float ?: 4 / 3 %}

{% if data.image %}
    {% if craft.app.config.general.devMode %}
        <!-- Image Transform Key: {{ requestedKey }}{{ transformKey != requestedKey ? ' (not in config/custom.php, using ' ~ transformKey ~ ')' }} -->
    {% endif %}

    {% if data.caption|length %}<figure>{% endif %}

    <div class="{{ classes.aspectRatio(data.aspectRatio) }} overflow-hidden">
        {% do data.image.setTransform({
            width: transformInfo.width,
            height: transformInfo.width / aspectRatio
        }) %}

        {# alt is set after the filter, so an empty value still renders alt="" for decorative images. #}
        {{ tag('img', {
            src: data.image.url,
            width: data.image.width,
            height: data.image.height,
            srcset: data.image.getSrcset(transformInfo.srcset ?? []),
            sizes: transformInfo.sizes ?? null,
            loading: data.loading,
            decoding: data.decoding,
            class: classes.combine(null, data.class)|string,
        }|filter|merge({
            alt: data.alt ?? data.image.alt ?? '',
        })|merge(data.attributes)) }}
    </div>

    {% if data.caption|length %}
        <figcaption class="mt-2 body-copy">{{ data.caption }}</figcaption>
    </figure>
    {% endif %}
{% endif %}
