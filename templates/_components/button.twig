{#
  Button: a link styled as a button, or a <button>.

  Inputs:
  - as: a for a link, or button (a)
  - url: where the link goes
  - text: the button's text
  - theme: primary, secondary or tertiary (primary)
  - size: sm, base, md or lg (base)
  - class: extra classes for the link or button
  - attributes: extra HTML attributes for the link or button, such as target, rel or aria-label. A link that opens in
    a new tab gets rel="noopener" and says so to screen readers. A <button> is type="button" unless attributes sets one.
#}
{% set data = {
    as: 'a',
    url: '',
    text: '',
    size: 'base',
    theme: 'primary',
    class: null,
    attributes: {}
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% set newTab = (data.attributes.target ?? null) == '_blank' %}
{% set newTabText = '(opens in a new tab)'|t %}
{% set attributes = data.attributes %}

{% if newTab %}
    {% set attributes = attributes|merge({
        rel: (attributes.rel ?? null) ?: 'noopener',
        'aria-label': (attributes['aria-label'] ?? null) ? attributes['aria-label'] ~ ' ' ~ newTabText : null,
    }) %}
{% endif %}

{% set sizeClasses = {
    sm: 'px-4 py-2 text-sm',
    base: 'px-5 py-2 text-base font-medium',
    md: 'px-6 py-3.5',
    lg: 'px-6 py-3.5 text-lg',
} %}

{% set themeClasses = {
    primary: 'border border-black bg-black text-white hover:opacity-80',
    secondary: 'border border-gray-200 bg-gray-200 hover:opacity-80',
    tertiary: 'px-0! border border-transparent hover:underline',
} %}

{#- One set of attributes per element: the class input and any class in attributes join the button's own. -#}
{% set attributes = attributes|merge({
    class: classes.combine(classes.combine([
        'inline-block rounded-full transition-opacity motion-reduce:transition-none',
        themeClasses[data.theme]|default(),
        sizeClasses[data.size]|default(),
    ], data.class)|string, attributes.class ?? null)|string,
}) %}

{% if data.as == 'a' %}
    <span class="relative inline-flex">
        <a {{ attr({ href: data.url }|merge(attributes)) }}>
            {{ data.text }}
            {%- if newTab %}<span class="sr-only"> {{ newTabText }}</span>{% endif %}
        </a>
        {% if data.theme == 'tertiary' %}
            <span aria-hidden="true" class="inline-flex items-center justify-center w-6 text-black">
                &rarr;
            </span>
        {% endif %}
    </span>
{% else %}
    <button {{ attr({ type: 'button' }|merge(attributes)) }}>{{ data.text }}</button>
{% endif %}
