{#
  Pagination: previous and next links, and up to 5 page numbers either side of the current page.

  Inputs:
  - pageInfo: the page info from {% paginate %}
#}
{% set data = {
    pageInfo: null,
}|merge(_context) %}

{% set pageInfo = data.pageInfo %}

<nav aria-label="{{ 'Pagination'|t }}">
    <ul class="flex justify-center items-center space-x-2">
        <li>
            {% if pageInfo.prevUrl %}
                <a class="inline-flex min-w-6 min-h-6 items-center justify-center" href="{{ pageInfo.prevUrl }}" aria-label="{{ 'Go to previous page'|t }}">
                    <span aria-hidden="true">&larr;</span>
                </a>
            {% else %}
                <span aria-hidden="true">&larr;</span>
            {% endif %}
        </li>

        {% for page, url in pageInfo.getPrevUrls(5) %}
            <li>
                <a class="inline-flex min-w-6 min-h-6 items-center justify-center" href="{{ url }}" aria-label="{{ 'Go to page {page}'|t({ page: page }) }}">{{ page }}</a>
            </li>
        {% endfor %}

        <li>
            <span class="inline-flex min-w-6 min-h-6 items-center justify-center font-medium" aria-current="page"><span class="sr-only">{{ 'Page'|t }} </span>{{ pageInfo.currentPage }}</span>
        </li>

        {% for page, url in pageInfo.getNextUrls(5) %}
            <li>
                <a class="inline-flex min-w-6 min-h-6 items-center justify-center" href="{{ url }}" aria-label="{{ 'Go to page {page}'|t({ page: page }) }}">{{ page }}</a>
            </li>
        {% endfor %}

        <li>
            {% if pageInfo.nextUrl %}
                <a class="inline-flex min-w-6 min-h-6 items-center justify-center" href="{{ pageInfo.nextUrl }}" aria-label="{{ 'Go to next page'|t }}">
                    <span aria-hidden="true">&rarr;</span>
                </a>
            {% else %}
                <span aria-hidden="true">&rarr;</span>
            {% endif %}
        </li>
    </ul>
</nav>
