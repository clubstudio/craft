{#
  Icon: a decorative SVG icon from an uploaded asset, hidden from screen readers.

  Inputs:
  - icon: the SVG asset
  - class: classes for the <svg> (size-8)
#}
{% set data = {
    icon: null,
    class: 'size-8',
}|merge(_context) %}

{% import '_macros/svg' as svgs %}

{% if data.icon %}
    <div>
        {{ svgs.asset(data.icon, { class: data.class, 'aria-hidden': 'true', focusable: 'false' }) }}
    </div>
{% endif %}
