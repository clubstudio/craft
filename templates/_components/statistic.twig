{#
  Statistic: a figure with a title and supporting text.

  Inputs:
  - value: the figure, such as 95%
  - title: what it counts
  - body: supporting rich text
  - class: extra classes for the wrapper
#}
{% set data = {
    value: '',
    title: '',
    body: null,
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

<div {{ attr({ class: classes.combine(null, data.class)|string ?: false }) }}>
    <div class="heading-2 pb-3 mb-2">{{ data.value }}</div>
    <div class="my-3">{{ data.title }}</div>
    {% include '_components/rich-text' with { body: data.body } only %}
</div>
