{% set data = {
    title: null,
    url: null,
    class: 'w-full h-full object-cover',
    aspectRatio: 'video',
    tracks: [],
    attributes: {
        muted: true,
        controls: true,
        playsinline: true,
    },
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% if data.url %}
    <figure class="{{ classes.aspectRatio(data.aspectRatio) }}">
        <video {{ attr(data.attributes) }} class="{{ data.class }}" aria-label="{{ data.title ?? 'Video'|t }}" preload="metadata">
            <source src="{{ data.url }}" type="video/mp4">
            {% for track in data.tracks %}
                {% set vttFile = track.vttFile.eagerly().one() %}
                {% if vttFile %}
                    <track
                        label="{{ track.title }}"
                        kind="captions"
                        srclang="{{ craft.app.language|slice(0, 2) }}"
                        src="{{ vttFile.url }}"
                        {% if loop.first %} default {% endif %}
                    />
                {% endif %}
            {% endfor %}
            {{ 'Your browser does not support the video tag.'|t }}
        </video>
    </figure>
{% endif %}
