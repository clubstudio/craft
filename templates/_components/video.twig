{% set data = {
    title: null,
    url: null,
    class: null,
    aspectRatio: 'video',
    tracks: [],
    attributes: {
        muted: true,
        controls: true,
        playsinline: true,
    },
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% if data.url %}
    <figure class="{{ classes.aspectRatio(data.aspectRatio) }}">
        <video {{ attr(data.attributes) }} class="{{ classes.combine('w-full h-full object-cover', data.class) }}" aria-label="{{ data.title ?? 'Video'|t }}" preload="metadata">
            <source src="{{ data.url }}" type="video/mp4">
            {% for track in data.tracks|filter(track => track.src ?? null) %}
                <track
                    label="{{ track.label ?? '' }}"
                    kind="captions"
                    srclang="{{ craft.app.language|slice(0, 2) }}"
                    src="{{ track.src }}"
                    {% if loop.first %} default {% endif %}
                />
            {% endfor %}
            {{ 'Your browser does not support the video tag.'|t }}
        </video>
    </figure>
{% endif %}
