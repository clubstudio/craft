{#
  Accordion: expandable items, using native <details>.

  Inputs:
  - items: the items, each { title, body }, body as rich text ([])
  - size: the space around each item, base or lg (base)
  - class: extra classes for the list
#}
{% set data = {
    items: [],
    size: 'base',
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% set sizes = {
    base: { list: '', item: 'py-4', body: 'pt-4' },
    lg: { list: '-my-6', item: 'py-6', body: 'pt-6' },
} %}
{% set sizeClasses = sizes[data.size] ?? sizes.base %}

{% if data.items|length %}
    <div class="{{ classes.combine(['divide-y', sizeClasses.list], data.class) }}">
        {% for item in data.items %}
            <details class="group {{ sizeClasses.item }}">
                {# list-none hides the native marker; [&::-webkit-details-marker]:hidden does the same in Safari, which ignores it. #}
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
                    {{ item.title }}
                    <span aria-hidden="true" class="shrink-0 text-xl leading-none transition-transform group-open:rotate-45 motion-reduce:transition-none">+</span>
                </summary>
                {% include '_components/rich-text' with {
                    body: item.body,
                    class: sizeClasses.body,
                } only %}
            </details>
        {% endfor %}
    </div>
{% endif %}
