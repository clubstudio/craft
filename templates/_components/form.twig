{#
  Form: a Formie form, rendered with the classes below (themeConfig) in place of Formie's own.

  Inputs:
  - form: the Formie form
#}
{% set data = {
    form: null,
}|merge(_context) %}

{{ craft.formie.renderForm(data.form, {
    themeConfig: {
        resetClasses: true,

        formTitle: {
            attributes: {
                class: 'text-lg leading-6 font-medium text-gray-900',
            },
        },

        messageError: {
            attributes: {
                class: 'rounded-md bg-red-50 border border-red-200 text-sm text-red-700 p-4 mb-4',
            },
        },

        messageSuccess: {
            attributes: {
                class: 'rounded-md bg-green-50 border border-green-200 text-sm text-green-700 p-4 mb-4',
            },
        },

        pageButtons: {
            attributes: {
                class: [
                    'flex -mx-2',
                    { if: { context: 'page.buttonsPosition', equals: 'left' }, then: 'justify-start' },
                    { if: { context: 'page.buttonsPosition', equals: 'right' }, then: 'justify-end' },
                    { if: { context: 'page.buttonsPosition', equals: 'center' }, then: 'justify-center' },
                    { if: { context: 'page.buttonsPosition', equals: 'left-right' }, then: 'justify-between' },
                    { if: { context: 'page.buttonsPosition', equals: 'right-save-left' }, then: 'justify-start flex-row-reverse' },
                    { if: { context: 'page.buttonsPosition', equals: 'center-save-left' }, then: 'justify-center flex-row-reverse' },
                    { if: { context: 'page.buttonsPosition', equals: 'center-save-right' }, then: 'justify-center' },
                    { if: { context: 'page.buttonsPosition', equals: 'save-right' }, then: 'justify-between' },
                    { if: { context: 'page.buttonsPosition', equals: 'save-left' }, then: 'justify-between flex-row-reverse' },
                ],
            },
        },

        buttonContainer: {
            attributes: {
                class: 'flex justify-start',
            },
        },

        saveButton: {
            attributes: {
                class: [
                    'inline-flex items-center px-4 py-2 border border-transparent rounded-full text-sm font-medium text-black hover:underline focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black',
                    'mx-2',
                ],
            },
        },

        backButton: {
            attributes: {
                class: [
                    'inline-flex items-center px-4 py-2 border border-transparent rounded-full text-sm font-medium text-gray-700 bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500',
                    'mx-2',
                ],
            },
        },

        submitButton: {
            attributes: {
                class: [
                    'inline-flex items-center px-4 py-2 border border-transparent rounded-full text-sm font-medium text-white bg-black focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black',
                    'mx-2 order-10',
                ],
            },
        },

        pageHidden: {
            attributes: {
                class: 'hidden',
            },
        },

        pageTabs: {
            attributes: {
                class: 'border-b border-gray-200 -mb-px flex space-x-8 mb-6',
            },
        },

        pageTab: {
            attributes: {
                class: 'py-4 px-1',
            },
        },

        pageTabLink: {
            attributes: {
                class: [
                    'whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm',
                    { if: 'page.hasErrors', then: 'text-red-700!' },
                ],
            },
        },

        tabLinkCurrent: {
            attributes: {
                class: 'border-black text-black',
            },
        },

        tabLinkInactive: {
            attributes: {
                class: 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
            },
        },

        pageTitle: {
            attributes: {
                class: 'text-lg leading-6 font-medium text-gray-900 mb-4',
            },
        },

        progress: {
            attributes: {
                class: 'flex h-1 text-sm text-white bg-white/20 rounded-full overflow-hidden mt-2',
            },
        },

        progressContainer: {
            attributes: {
                class: 'flex flex-col justify-center text-center font-medium bg-black',
            },
        },

        subFieldRow: {
            attributes: {
                class: 'flex flex-wrap -mx-4 mb-4 last:mb-0',
            },
        },

        nestedFieldRows: {
            attributes: {
                class: 'border py-4',
            },
        },

        nestedFieldRow: {
            attributes: {
                class: 'flex flex-wrap mb-4 last:mb-0',
            },
        },

        row: {
            attributes: {
                class: 'flex flex-wrap -mx-4 mb-4',
            },
        },

        rowHidden: {
            attributes: {
                class: 'hidden',
            },
        },

        field: {
            attributes: {
                class: 'px-4 flex-1',
            },
        },

        fieldLabel: {
            attributes: {
                class: 'mb-1 block text-sm font-medium',
            },
        },

        fieldRequired: {
            attributes: {
                class: 'text-red-600',
            },
        },

        fieldInstructions: {
            attributes: {
                class: 'mb-1 text-sm text-gray-500',
            },
        },

        fieldInput: {
            attributes: {
                class: 'border p-3 shadow-sm focus:ring-black focus:border-black block w-full sm:text-sm border-gray-500 rounded-md',
            },
        },

        fieldControlError: {
            attributes: {
                class: 'border-red-700!',
            },
        },

        fieldError: {
            attributes: {
                class: 'text-red-700 text-sm mt-1',
            },
        },

        fieldAddButton: {
            attributes: {
                class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-gray-700 bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500',
            },
        },

        fieldRemoveButton: {
            attributes: {
                class: 'inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-gray-700 bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500',
            },
        },

        fieldLimit: {
            attributes: {
                class: 'mt-2 text-sm text-gray-500',
            },
        },

        agree: {
            fieldOption: {
                attributes: {
                    class: 'flex items-start mb-2',
                },
            },

            fieldOptionLabel: {
                attributes: {
                    class: 'ml-2 text-sm leading-4',
                },
            },

            fieldInput: {
                resetClass: true,

                attributes: {
                    class: 'focus:ring-black h-4 w-4 text-black border-gray-500 rounded',
                },
            },
        },

        checkboxes: {
            fieldOption: {
                attributes: {
                    class: {
                        if: { context: 'field.layout', equals: 'horizontal' },
                        then: 'inline-block mr-4',
                        else: 'flex items-start mb-2',
                    },
                },
            },

            fieldOptionLabel: {
                attributes: {
                    class: 'ml-2 text-sm leading-4',
                },
            },

            fieldInput: {
                resetClass: true,

                attributes: {
                    class: 'focus:ring-black h-4 w-4 text-black border-gray-500 rounded',
                },
            },
        },

        dropdown: {
            fieldInput: {
                resetClass: true,

                attributes: {
                    class: 'shadow-sm focus:ring-black focus:border-black block w-full sm:text-sm border-gray-500 rounded-md',
                },
            },
        },

        fileUpload: {
            fieldInput: {
                resetClass: true,

                attributes: {
                    class: 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-gray-200 file:text-gray-700 hover:file:bg-gray-300',
                },
            },
        },

        hiddenField: {
            field: {
                resetClass: true,

                attributes: {
                    class: 'hidden',
                },
            },
        },

        radioButtons: {
            fieldOption: {
                attributes: {
                    class: {
                        if: { context: 'field.layout', equals: 'horizontal' },
                        then: 'inline-block mr-4',
                        else: 'flex items-start mb-2',
                    },
                },
            },

            fieldOptionLabel: {
                attributes: {
                    class: 'ml-2 text-sm leading-4',
                },
            },

            fieldInput: {
                resetClass: true,

                attributes: {
                    class: 'focus:ring-black h-4 w-4 text-black border-gray-500',
                },
            },
        },

        recipients: {
            field: {
                attributes: {
                    class: [
                        { if: 'field.isHidden', then: 'hidden' },
                    ],
                },
            },
        },

        repeater: {
            nestedField: {
                attributes: {
                    class: 'relative',
                },
            },

            nestedFieldWrapper: {
                attributes: {
                    class: 'mb-4',
                },
            },

            fieldRemoveButton: {
                attributes: {
                    class: 'absolute top-0 right-0 m-1 inline-flex items-center px-2 py-1.5 border border-transparent text-xs font-medium rounded-md text-gray-700 bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500',
                },
            },
        },

        signature: {
            fieldControl: {
                attributes: {
                    class: 'relative',
                },
            },

            fieldCanvas: {
                attributes: {
                    class: 'w-full h-[8rem] border bg-gray-100',
                },
            },

            fieldRemoveButton: {
                attributes: {
                    class: 'absolute top-0 right-0 m-1 inline-flex items-center px-2 py-1 border border-gray-300 text-xs font-medium rounded-md text-gray-700 bg-gray-200 hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500',
                },
            },
        },

        table: {
            fieldTable: {
                attributes: {
                    class: 'min-w-full divide-y divide-gray-300',
                },
            },

            fieldTableHeaderColumn: {
                attributes: {
                    class: 'px-3 py-3.5 text-left text-sm font-semibold text-gray-900',
                },
            },

            fieldTableBody: {
                attributes: {
                    class: 'divide-y divide-gray-200 bg-white',
                },
            },

            fieldTableBodyColumn: {
                attributes: {
                    class: 'whitespace-nowrap px-3 py-4 text-sm text-gray-500',
                },
            },
        },
    },
}) }}
