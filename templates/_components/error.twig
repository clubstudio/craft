{#
  Error: an error page's message, with a link home. Used by _layouts/error.

  Inputs:
  - heading: the page's <h1>
  - body: a sentence on what went wrong
#}
{% set data = {
    heading: '',
    body: '',
}|merge(_context) %}

<div class="max-w-sm">
    {% include '_components/heading' with { level: 'h1', appearance: 'h2', heading: data.heading } only %}
    <p class="my-6">{{ data.body }}</p>
    <a href="{{ url() }}" class="underline underline-offset-4">
        <span aria-hidden="true">&larr;</span> {{ 'Go home'|t }}
    </a>
</div>
