{% set data = {
    level: 'h2',
    appearance: null,
    heading: '',
    class: null,
    attributes: {},
    classMap: {
        h1: 'heading-1',
        h2: 'heading-2',
        h3: 'heading-3',
        h4: 'heading-4',
        h5: 'heading-5',
        h6: 'heading-6',
    },
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% set element = data.level %}

{% tag element with {
    class: classes.combine([data.classMap[data.appearance ?? data.level], 'text-balance'], data.class)|string,
}|merge(data.attributes) %}
    {{ data.heading }}
{% endtag %}
