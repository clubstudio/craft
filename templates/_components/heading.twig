{#
  Heading: a heading at any level, styled as that level or another.

  Inputs:
  - heading: the text
  - level: the element, h1 to h6 (h2)
  - appearance: the level it looks like, h1 to h6 (level)
  - classMap: the class for each appearance (heading-1 to heading-6, from site.css)
  - class: extra classes
  - attributes: extra HTML attributes
#}
{% set data = {
    level: 'h2',
    appearance: null,
    heading: '',
    class: null,
    attributes: {},
    classMap: {
        h1: 'heading-1',
        h2: 'heading-2',
        h3: 'heading-3',
        h4: 'heading-4',
        h5: 'heading-5',
        h6: 'heading-6',
    },
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% set element = data.level %}

{% tag element with {
    class: classes.combine([data.classMap[data.appearance ?? data.level], 'text-balance'], data.class)|string,
}|merge(data.attributes) %}
    {{ data.heading }}
{% endtag %}
