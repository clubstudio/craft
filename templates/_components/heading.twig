{% set data = {
    level: 'h2',
    heading: '',
    class: null,
    attributes: {},
    classMap: {
        h1: 'font-bold text-5xl',
        h2: 'font-bold text-4xl',
        h3: 'font-bold text-3xl',
        h4: 'text-2xl',
        h5: 'text-xl',
        h6: 'text-lg',
    },
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% set element = data.level %}

{% tag element with {
    class: classes.combine([data.classMap[data.level], 'text-balance'], data.class),
}|merge(data.attributes) %}
    {{ data.heading }}
{% endtag %}
