{#
  Eyebrow: a short label shown above a heading. Nothing renders without text.

  Inputs:
  - text: the label
  - class: extra classes for the <p>
#}
{% set data = {
    text: '',
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% if data.text|length %}
    <p class="{{ classes.combine('text-sm font-medium uppercase tracking-wide', data.class) }}">{{ data.text }}</p>
{% endif %}
