{#
  List: a bulleted list.

  Inputs:
  - items: each item's text or rich text ([])
  - class: extra classes for the <ul>
#}
{% set data = {
    items: [],
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}

{% if data.items|length %}
    <ul class="{{ classes.combine('list-disc pl-5 space-y-2', data.class) }}">
        {% for item in data.items %}
            <li class="body-copy">{{ item }}</li>
        {% endfor %}
    </ul>
{% endif %}
