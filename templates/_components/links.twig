{#
  Links: a row of buttons.

  Inputs:
  - links: each { url, text, theme, target, rel, ariaLabel, download, id }; links without a url are left out ([])
#}
{% set data = {
    links: [],
}|merge(_context) %}

{% set links = data.links|filter(link => link.url ?? null) %}

{% if links|length %}
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-3 in-[.text-center]:justify-center in-[.text-right]:justify-end">
        {% for link in links %}
            <li>
                {% include '_components/button' with {
                    theme: link.theme ?? 'primary',
                    url: link.url,
                    text: link.text ?? '',
                    attributes: {
                        target: link.target ?? null,
                        rel: link.rel ?? null,
                        'aria-label': link.ariaLabel ?? null,
                        download: link.download ?? null,
                        id: link.id ?? null,
                    },
                } only %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
