{# A row of buttons. Each link is { url, text, theme, target, rel, ariaLabel }. #}
{% set data = {
    links: [],
}|merge(_context) %}

{% set links = data.links|filter(link => link.url ?? null) %}

{% if links|length %}
    <ul>
        {% for link in links %}
            <li class="inline-block">
                {% include '_components/button' with {
                    theme: link.theme ?? 'primary',
                    url: link.url,
                    text: link.text ?? '',
                    class: [
                        not loop.last ? 'mr-2',
                    ],
                    attributes: {
                        target: link.target ?? null,
                        rel: link.rel ?? null,
                        'aria-label': link.ariaLabel ?? null,
                    },
                } only %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
