{# A row of buttons. Each link is { url, text, theme, target, rel, ariaLabel, download, id }. #}
{% set data = {
    links: [],
}|merge(_context) %}

{% set links = data.links|filter(link => link.url ?? null) %}

{% if links|length %}
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-3">
        {% for link in links %}
            <li>
                {% include '_components/button' with {
                    theme: link.theme ?? 'primary',
                    url: link.url,
                    text: link.text ?? '',
                    attributes: {
                        target: link.target ?? null,
                        rel: link.rel ?? null,
                        'aria-label': link.ariaLabel ?? null,
                        download: link.download ?? null,
                        id: link.id ?? null,
                    },
                } only %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
