{#
  Logos: a row of logos, each optionally a link.

  Inputs:
  - logos: each { name, image, url, target, rel, ariaLabel, download, id }; only image is needed ([]). A logo's
    accessible name is its ariaLabel, then the image's alt text, then name, so give it a name: without one, a logo
    whose image has no alt text can't be identified by screen readers, and a linked one is an empty link.
  - class: extra classes for the <ul>
#}
{% set data = {
    logos: [],
    class: null,
}|merge(_context) %}

{% import '_macros/classes' as classes %}
{% import '_macros/svg' as svgs %}

{% set logos = data.logos|filter(logo => logo.image ?? null) %}

{% if logos|length %}
    <ul class="{{ classes.combine('flex items-center justify-between flex-wrap -m-6', data.class) }}">
        {% for logo in logos %}
            {% set asset = logo.image %}
            {% set url = logo.url ?? null %}
            {% set newTab = url and (logo.target ?? null) == '_blank' %}
            {% set label = (logo.ariaLabel ?? null) ?: asset.alt ?: (logo.name ?? null) %}

            <li class="p-6 flex justify-center">
                {% tag (url ? 'a' : 'div') with url ? {
                    href: url,
                    target: logo.target ?? null,
                    rel: newTab ? ((logo.rel ?? null) ?: 'noopener') : (logo.rel ?? null),
                    'aria-label': label ? label ~ (newTab ? ' ' ~ '(opens in a new tab)'|t) : null,
                    download: logo.download ?? null,
                    id: logo.id ?? null,
                } : {} %}
                    {% if asset.format == 'svg' %}
                        {{ svgs.asset(asset, url ? {
                            height: 36,
                            'aria-hidden': 'true',
                            focusable: 'false',
                        } : {
                            height: 36,
                            role: label ? 'img' : null,
                            'aria-label': label ?: null,
                            'aria-hidden': label ? null : 'true',
                            focusable: 'false',
                        }) }}
                    {% else %}
                        {% include '_components/image' with {
                            image: asset,
                            alt: url ? '' : (label ?? ''),
                            transformKey: 'logo',
                            aspectRatio: 'auto',
                            class: 'h-9 w-auto',
                        } only %}
                    {% endif %}
                {% endtag %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
