{% extends '_layouts/master' %}

{% import '_macros/classes' as classes %}

{% do seomatic.meta.seoTitle('Style guide') %}

{% set sampleImage = craft.assets.kind('image').one() %}
{% set sampleSvg = craft.assets.kind('image').filename('*.svg').one() %}
{% set sampleForm = craft.formie.forms().one() %}

{% block content %}
    <div class="px-gutter py-12 flex flex-col gap-block">
        {% include '_components/heading' with { level: 'h1', heading: 'Style guide' } only %}

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Headings' } only %}
            {% for level in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'] %}
                {% include '_components/heading' with {
                    level: level,
                    heading: level|upper ~ ': The quick brown fox jumps over the lazy dog',
                    attributes: { role: 'presentation' },
                } only %}
            {% endfor %}
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Eyebrow' } only %}
            {% include '_components/eyebrow' with { text: 'An eyebrow above a heading' } only %}
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Rich text' } only %}
            {% set sampleRichText %}
                <p>A paragraph of body copy with <a href="#">a link</a> and <strong>some strong text</strong>. It runs long enough to wrap onto a second line so you can check the line height and measure.</p>
                <ul>
                    <li>A bulleted list item</li>
                    <li>Another bulleted list item</li>
                </ul>
                <ol>
                    <li>A numbered list item</li>
                    <li>Another numbered list item</li>
                </ol>
                <h2>A heading in rich text</h2>
                <p>Headings in Rich Text use the same styles as the heading component.</p>
                <h3>A third-level heading</h3>
                <p>Another paragraph to show the space below a heading.</p>
                <h4>A fourth-level heading</h4>
                <p>And one more.</p>
            {% endset %}
            {% include '_components/rich-text' with { body: sampleRichText, class: 'max-w-narrow' } only %}
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'List' } only %}
            {% include '_components/list' with {
                items: ['A short list item', 'Another short list item', 'A third, slightly longer list item'],
            } only %}
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Statistics' } only %}
            <div class="grid gap-6 md:grid-cols-3">
                {% for value in ['98%', '12k', '24/7'] %}
                    {% include '_components/statistic' with {
                        value: value,
                        title: 'Statistic title',
                        body: 'Supporting text that explains the figure.',
                    } only %}
                {% endfor %}
            </div>
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Accordion' } only %}
            {% set sampleItems = [
                { title: 'The first question', body: 'The answer to the first question.' },
                { title: 'A second question', body: 'The answer to the second question.' },
                { title: 'A third question', body: 'The answer to the third question.' },
            ] %}
            {% include '_components/accordion' with { items: sampleItems } only %}
            <p class="text-sm">Size lg, as in FAQs:</p>
            <div class="py-6">
                {% include '_components/accordion' with { items: sampleItems, size: 'lg' } only %}
            </div>
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Testimonial' } only %}
            {% include '_components/testimonial' with {
                quote: 'A short quote from a happy client about working with the team.',
                person: 'Person Name',
                company: 'Company',
                image: sampleImage,
                class: 'max-w-narrow',
            } only %}
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Buttons' } only %}
            {% for theme in ['primary', 'secondary', 'tertiary'] %}
                <div class="flex flex-wrap items-center gap-4">
                    {% for size in ['sm', 'base', 'md', 'lg'] %}
                        {% include '_components/button' with {
                            url: '#',
                            text: theme|capitalize ~ ' ' ~ size,
                            theme: theme,
                            size: size,
                        } only %}
                    {% endfor %}
                </div>
            {% endfor %}
            <div class="flex flex-wrap items-center gap-4">
                {% include '_components/button' with { as: 'button', text: 'Button element' } only %}
                {% include '_components/button' with {
                    url: 'https://example.com',
                    text: 'Opens in a new tab',
                    attributes: { target: '_blank' },
                } only %}
            </div>
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Links' } only %}
            {% include '_components/links' with {
                links: [
                    { url: '#', text: 'Primary link' },
                    { url: '#', text: 'Secondary link', theme: 'secondary' },
                    { url: '#', text: 'Tertiary link', theme: 'tertiary' },
                ],
            } only %}
        </section>

        {% if sampleImage %}
            <section class="flex flex-col gap-6">
                {% include '_components/heading' with { heading: 'Images' } only %}
                <div class="grid gap-6 md:grid-cols-3">
                    {% for ratio in ['photo', 'photo-portrait', 'square', 'video', 'pano', 'auto'] %}
                        <figure>
                            {% include '_components/image' with {
                                image: sampleImage,
                                alt: '',
                                aspectRatio: ratio,
                                class: 'w-full h-full object-cover',
                            } only %}
                            <figcaption class="mt-2 text-sm">{{ ratio }}</figcaption>
                        </figure>
                    {% endfor %}
                </div>
                {% include '_components/image' with {
                    image: sampleImage,
                    alt: '',
                    caption: 'An image with a caption.',
                    class: 'w-full h-full object-cover max-w-narrow',
                } only %}
            </section>

            <section class="flex flex-col gap-6">
                {% include '_components/heading' with { heading: 'Logos' } only %}
                {% include '_components/logos' with {
                    logos: [
                        { image: sampleSvg ?? sampleImage },
                        { image: sampleImage, url: '#', ariaLabel: 'A linked logo' },
                        { image: sampleSvg ?? sampleImage },
                    ],
                } only %}
            </section>
        {% endif %}

        {% if sampleSvg %}
            <section class="flex flex-col gap-6">
                {% include '_components/heading' with { heading: 'Icon' } only %}
                {% include '_components/icon' with { icon: sampleSvg } only %}
            </section>
        {% endif %}

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Divider' } only %}
            {% include '_components/divider' only %}
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Dates' } only %}
            <p>{% include '_components/date' with { date: date('-2 days') } only %}</p>
            <p>{% include '_components/date' with { date: date('-1 year') } only %}</p>
        </section>

        <section class="flex flex-col gap-6">
            {% include '_components/heading' with { heading: 'Breadcrumb' } only %}
            {% include '_components/breadcrumb' only %}
        </section>

        {% if sampleForm %}
            <section class="flex flex-col gap-6 max-w-narrow">
                {% include '_components/heading' with { heading: 'Form' } only %}
                {% include '_components/form' with { form: sampleForm } only %}
            </section>
        {% endif %}
    </div>

    <section class="py-12 flex flex-col gap-6 bg-gray-100">
        <div class="px-gutter">
            {% include '_components/heading' with { heading: 'Content widths' } only %}
        </div>
        {% for width in ['full-bleed', 'full-width', 'medium', 'narrow'] %}
            <div{% if width != 'full-bleed' %} class="px-gutter"{% endif %}>
                <div class="bg-white p-4 text-sm {{ classes.contentMaxWidth(width) }} {{ width in ['medium', 'narrow'] ? 'mx-auto' }}">{{ width }}</div>
            </div>
        {% endfor %}
    </section>
{% endblock %}
