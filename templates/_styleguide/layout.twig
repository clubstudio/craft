{# The style guide's Layout section. Diagrams use the real layout components, so measurements always match the site. #}
{% import '_styleguide/macros' as guide %}
{% import _self as diagram %}

{# Hatching is space (gutter, gaps), grey is the width available to content, blue is content and grey boxes are media. #}
{% set pattern = '[--pattern-fg:color-mix(in_oklab,var(--color-black)_8%,transparent)]' %}
{% set space = pattern ~ ' bg-[image:repeating-linear-gradient(315deg,var(--pattern-fg)_0,var(--pattern-fg)_1px,transparent_0,transparent_50%)] bg-size-[10px_10px] bg-fixed' %}
{% set spaceAround = pattern ~ ' [background:linear-gradient(var(--color-gray-50),var(--color-gray-50))_content-box,repeating-linear-gradient(315deg,var(--pattern-fg)_0,var(--pattern-fg)_1px,transparent_0,transparent_50%)_0_0/10px_10px_fixed_padding-box]' %}
{% set content = 'bg-sky-50 ring-1 ring-inset ring-sky-300 text-sky-700' %}
{% set media = 'bg-gray-200 text-gray-600' %}

{% set widths = [
    { value: 'full-bleed', name: 'Full bleed', description: 'Edge to edge, with no gutter. For images and coloured bands.' },
    { value: 'full-width', name: 'Full width', description: 'The page width minus the gutter. The default.' },
    { value: 'medium', name: 'Medium', description: 'Capped at max-w-medium, then centred or aligned left or right.' },
    { value: 'narrow', name: 'Narrow', description: 'Capped at max-w-narrow. For text that should keep a readable line length.' },
] %}

{% set splits = [
    { name: 'Media left', mediaPosition: 'left', width: 'full-width' },
    { name: 'Media right', mediaPosition: 'right', width: 'full-width' },
    { name: 'Full bleed', mediaPosition: 'left', width: 'full-bleed', description: 'The media runs to the edge; the content keeps the gutter on its outer side.' },
] %}

{% set columnLayouts = [
    { value: '11', name: '1:1' },
    { value: '12', name: '1:2' },
    { value: '21', name: '2:1' },
    { value: '13', name: '1:3' },
    { value: '31', name: '3:1' },
    { value: '111', name: '1:1:1' },
] %}

<section class="flex flex-col gap-12 pb-16">
    <div class="px-gutter">
        <div class="grid gap-8 border-t border-gray-200 pt-12 lg:grid-cols-12">
            {{ guide.heading('09', 'Layout') }}
            <div class="flex flex-col gap-4 lg:col-span-9">
                <p class="max-w-narrow text-sm">Every Section block sits inside the gutter. Its Content Width sets how wide the content can be, and the blocks inside it are spaced by the block gap. Content & Media and Columns lay out their own content inside that. Sizes are measured at the current window width, so resize to see them change.</p>
                <ul class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-gray-500">
                    <li class="flex items-center gap-2"><span class="size-4 ring-1 ring-black/10 {{ space }}"></span> Space: gutter and gaps</li>
                    <li class="flex items-center gap-2"><span class="size-4 bg-gray-50 ring-1 ring-black/10"></span> Available width</li>
                    <li class="flex items-center gap-2"><span class="size-4 {{ content }}"></span> Content</li>
                    <li class="flex items-center gap-2"><span class="size-4 {{ media }}"></span> Media</li>
                </ul>
            </div>
        </div>
    </div>

    {# Content widths #}
    <div class="flex flex-col gap-8">
        <div class="px-gutter">{{ guide.label('Content widths') }}</div>
        {% for width in widths %}
            <div data-measure-row class="flex flex-col gap-3">
                {{ diagram.rowHeader(width.name, width.description, 'content <span data-measure="content"></span> · gutter <span data-measure="gutter"></span>') }}
                {% embed '_components/layout/container' with { width: width.value, class: spaceAround ~ ' py-4', content: content } only %}
                    {% block content %}
                        {% import '_styleguide/macros' as guide %}
                        <div data-measure-content class="flex flex-col gap-2">
                            <div class="flex h-12 items-center justify-center font-mono text-xs {{ content }}">{{ width }}</div>
                            {{ guide.dimension() }}
                        </div>
                    {% endblock %}
                {% endembed %}
            </div>
        {% endfor %}

        <div data-measure-row class="flex flex-col gap-3">
            {{ diagram.rowHeader('Block gap', 'The space between blocks in a Section, set by gap-block.', 'gap <span data-measure="gap"></span>') }}
            {% embed '_components/layout/container' with { class: space, content: content } only %}
                {% block content %}
                    {% for i in 1..2 %}
                        <div {{ attr({ 'data-measure-gap': loop.first ? 'row' : false }) }} class="flex h-16 items-center justify-center font-mono text-xs {{ content }}">Block {{ i }}</div>
                    {% endfor %}
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# Content & Media #}
    <div class="flex flex-col gap-8">
        <div class="px-gutter">{{ guide.label('Content & Media') }}</div>
        {% for split in splits %}
            <div data-measure-row class="flex flex-col gap-3">
                {{ diagram.rowHeader(split.name, split.description ?? 'Media beside content, stacked on mobiles.', 'gap <span data-measure="gap"></span>') }}
                {% embed '_components/layout/container' with { width: split.width, class: space, split: split, content: content, media: media } only %}
                    {% block content %}
                        {% embed '_components/layout/split' with {
                            mediaPosition: split.mediaPosition,
                            fullBleed: split.width == 'full-bleed',
                            content: content,
                            media: media,
                        } only %}
                            {% block media %}
                                <div data-measure-self data-measure-gap="column" class="flex aspect-[4/3] items-center justify-center font-mono text-xs {{ media }}">Media · <span data-measure="self"></span></div>
                            {% endblock %}
                            {% block content %}
                                <div data-measure-self class="flex h-24 items-center justify-center font-mono text-xs {{ content }}">Content · <span data-measure="self"></span></div>
                            {% endblock %}
                        {% endembed %}
                    {% endblock %}
                {% endembed %}
            </div>
        {% endfor %}
    </div>

    {# Columns #}
    <div class="flex flex-col gap-8">
        <div class="px-gutter">{{ guide.label('Columns') }}</div>
        {% for layout in columnLayouts %}
            <div data-measure-row class="flex flex-col gap-3">
                {{ diagram.rowHeader(layout.name, null, 'gap <span data-measure="gap"></span>') }}
                {% embed '_components/layout/container' with { class: space, layout: layout, content: content } only %}
                    {% block content %}
                        {% embed '_components/layout/columns' with { layout: layout.value, content: content } only %}
                            {% block content %}
                                {% for column in 1..(layout|length) %}
                                    <div data-measure-self {{ attr({ 'data-measure-gap': loop.first ? 'column' : false }) }} class="flex h-16 items-center justify-center font-mono text-xs {{ content }}">
                                        <span data-measure="self"></span>
                                    </div>
                                {% endfor %}
                            {% endblock %}
                        {% endembed %}
                    {% endblock %}
                {% endembed %}
            </div>
        {% endfor %}
    </div>
</section>

{% macro rowHeader(name, description, measures) %}
    <div class="px-gutter flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <p class="text-sm"><span class="font-medium">{{ name }}</span>{% if description %} <span class="text-gray-500">{{ description }}</span>{% endif %}</p>
        <p class="font-mono text-xs text-gray-500">{{ measures|raw }}</p>
    </div>
{% endmacro %}
