{# Joins a component's own classes with a caller's `class` input. Either may be a string, an array or null. #}
{% macro combine(base, extra = null) %}
    {{- ((base is iterable ? base : [base])|merge(extra is iterable ? extra : [extra]))|filter|join(' ') -}}
{% endmacro %}

{# Padding Top and Padding Bottom share one scale: change both together. #}
{% macro paddingTop(preference = 'none') %}
    {{- attribute({
        none: 'pt-0',
        sm: 'pt-4 md:pt-6 lg:pt-8',
        md: 'pt-8 md:pt-12 lg:pt-16',
        lg: 'pt-12 md:pt-16 lg:pt-24',
    }, preference) -}}
{% endmacro %}

{% macro paddingBottom(preference = 'none') %}
    {{- attribute({
        none: 'pb-0',
        sm: 'pb-4 md:pb-6 lg:pb-8',
        md: 'pb-8 md:pb-12 lg:pb-16',
        lg: 'pb-12 md:pb-16 lg:pb-24',
    }, preference) -}}
{% endmacro %}

{# Caps the content of a Medium or Narrow section; Full width and Full bleed have no cap. #}
{% macro contentMaxWidth(preference = null) %}
    {{- attribute({
        medium: 'max-w-medium',
        narrow: 'max-w-narrow',
    }, preference) ?? '' -}}
{% endmacro %}

{% macro horizontalAlignment(preference = 'none') %}
    {{- attribute({
        none: '',
        left: 'ml-0 mr-auto',
        center: 'mx-auto',
        right: 'ml-auto mr-0',
    }, preference) -}}
{% endmacro %}

{% macro backgroundColor(preference = 'none') %}
    {{- attribute({
        'none': 'bg-none',
        'black': 'bg-black',
        'white': 'bg-white',
    }, preference) -}}
{% endmacro %}

{% macro fontSize(preference = 'none') %}
    {{- attribute({
        'xs': 'text-xs lg:text-sm',
        'sm': 'text-sm lg:text-base',
        'base': 'text-base',
        'lg': 'text-lg',
        'xl': 'text-xl',
        '2xl': 'text-2xl',
        '3xl': 'text-3xl',
    }, preference) -}}
{% endmacro %}

{% macro textAlignment(preference = 'center') %}
    {{- attribute({
        left: 'text-left',
        center: 'text-center',
        right: 'text-right',
        justify: 'text-justify',
    }, preference) -}}
{% endmacro %}

{% macro verticalAlignment(preference = 'middle') %}
    {{- attribute({
        top: 'items-start',
        middle: 'items-center',
        bottom: 'items-end',
    }, preference) -}}
{% endmacro %}

{% macro aspectRatio(preference = 'photo') %}
    {%- set ratios = {
        'auto': null,
        'video': 'aspect-video',
        'photo': 'aspect-[4/3]',
        'photo-portrait': 'aspect-[3/4]',
        'pano': 'aspect-[21/9]',
        'square': 'aspect-square',
    } -%}
    {{- (preference ?: 'photo') in ratios|keys ? ratios[preference ?: 'photo'] : ratios.photo -}}
{% endmacro %}

{# In a Full bleed Content & Media block, the text keeps the gutter on its outer side only. #}
{% macro sectionTextContainer(preference = null) %}
    {{- attribute({
        'section:full-bleed:content-and-media:media-right': 'px-gutter lg:pr-0',
        'section:full-bleed:content-and-media:media-left': 'px-gutter lg:pl-0',
    }, preference) ?? null -}}
{% endmacro %}

{% macro columnLayout(preference = null) %}
    {{- attribute({
        '111': 'lg:grid-cols-3',
        '11': 'lg:grid-cols-[1fr_1fr]',
        '12': 'lg:grid-cols-[1fr_2fr]',
        '21': 'lg:grid-cols-[2fr_1fr]',
        '13': 'lg:grid-cols-[1fr_3fr]',
        '31': 'lg:grid-cols-[3fr_1fr]',
    }, preference ?? '11') -}}
{% endmacro %}
