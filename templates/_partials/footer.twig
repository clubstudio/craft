{% set callToActionText = siteSettings.callToAction.eagerly().all() %}

<footer class="py-6">
    <div class="px-gutter grid grid-cols-1 md:grid-cols-3 gap-12 justify-between text-sm mb-12">
        {% if callToActionText|length %}
            <div class="space-y-6">
                {% include '_builder/builder' with {
                    context: 'footer',
                    blocks: callToActionText,
                } only %}
            </div>
        {% endif %}
        {% set footerNodes = craft.navigation.nodes().handle('footerNavigation').level(1).with(['children']).all() %}
        {% if footerNodes|length %}
            {# Each Group / Column is a column with its links beneath; top-level links share a column of their own. #}
            {% set looseLinks = footerNodes|filter(node => not node.isGroupColumn()) %}
            <nav aria-label="{{ 'Footer navigation'|t }}" class="grid grid-cols-2 gap-8 sm:grid-cols-3">
                {% if looseLinks|length %}
                    <ul class="flex flex-col gap-2">
                        {% for node in looseLinks %}
                            <li>{% include '_partials/nav-link' with { node: node, activeClass: ['underline', 'underline-offset-4'] } only %}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% for group in footerNodes|filter(node => node.isGroupColumn()) %}
                    <div class="flex flex-col gap-3">
                        <h2 class="font-medium">{{ group.title }}</h2>
                        <ul class="flex flex-col gap-2">
                            {% for node in group.children.all() %}
                                <li>{% include '_partials/nav-link' with { node: node, activeClass: ['underline', 'underline-offset-4'] } only %}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </nav>
        {% endif %}
        {% set newsletterForm = siteSettings.newsletterForm.eagerly().one() %}
        {% if newsletterForm %}
            <div>
                {% include '_components/form' with { form: newsletterForm } only %}
            </div>
        {% endif %}
    </div>
    <div class="px-gutter flex flex-wrap gap-6 justify-between text-xs">
        <div class="flex flex-wrap items-center gap-6">
            {% if siteSettings.copyrightNotice|length %}
                <p>{{ siteSettings.copyrightNotice|replace({
                    ':year': 'now'|date('Y'),
                    ':siteName': siteName,
                }) }}</p>
            {% endif %}
            {% set nodes = craft.navigation.nodes().handle('legalLinks').all() %}
            {% if nodes|length %}
                <nav aria-label="{{ 'Legal'|t }}">
                    <ul class="flex flex-wrap gap-6">
                        {% for node in nodes %}
                            <li>
                                {% include '_partials/nav-link' with { node: node, activeClass: ['underline', 'underline-offset-4'] } only %}
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </div>
        {% set socialProfiles = siteSettings.socialProfiles.eagerly().all() %}
        {% if socialProfiles|length %}
            <nav aria-label="{{ 'Social networks'|t }}">
                <div class="flex gap-4">
                    {% for socialProfile in socialProfiles %}
                        <a
                            href="{{ socialProfile.profileUrl }}"
                            {% if socialProfile.profileUrl.target %} target="{{ socialProfile.profileUrl.target }}" {% endif %}
                            rel="{{ socialProfile.profileUrl.rel ?? 'nofollow noopener noreferrer' }}"
                            aria-label="{{ 'Visit {profile}'|t({ 'profile': socialProfile.socialNetwork.label }) }}{{ socialProfile.profileUrl.target == '_blank' ? ' ' ~ '(opens in a new tab)'|t }}"
                        >
                            {{ svg('@svg/social/' ~ socialProfile.socialNetwork ~ '.svg')|attr({
                                'title': socialProfile.socialNetwork.label,
                                'class': 'h-4',
                                'fill': 'currentColor',
                                'focusable': 'false',
                                'aria-hidden': 'true',
                            }) }}
                        </a>
                    {% endfor %}
                </div>
            </nav>
        {% endif %}
    </div>
</footer>
