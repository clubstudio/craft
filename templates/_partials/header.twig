<header class="py-8">
    <div class="px-gutter flex flex-wrap items-center justify-between gap-x-6">
        {% include '_components/site-logo' only %}
        {# The menu is one level deep (maxLevels: 1). level(1) keeps it that way here if a project allows submenus, until it renders them. #}
        {% set nodes = craft.navigation.nodes().handle('mainNavigation').level(1).all() %}
        {% if nodes|length %}
            <button type="button" class="peer -m-2 p-2 font-medium md:hidden no-js:hidden" aria-expanded="false" aria-controls="main-navigation" data-nav-toggle>
                {{ 'Menu'|t }}
            </button>
            <nav id="main-navigation" aria-label="{{ 'Main navigation'|t }}" class="hidden w-full peer-aria-expanded:block no-js:block md:block md:w-auto">
                <ul class="flex flex-col gap-4 pt-6 text-[15px] md:flex-row md:gap-8 md:pt-0">
                    {% for node in nodes %}
                        <li>
                            {% include '_partials/nav-link' with { node: node, activeClass: ['underline', 'underline-offset-4'] } only %}
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
    </div>
</header>
