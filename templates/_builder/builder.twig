{#
  Content Builder

  Renders a list of blocks, choosing each one's template by context.

  Variables:
  - blocks: the blocks to render
  - context: optional, a name or a list of names tried in order (e.g. ['columns/2', 'columns'])
  - transformKey: optional, the image transform key so far (see config/custom.php)

  Template resolution, for each context in turn, then the default:
  1. _builder/blocks/{context}/{block-type}.twig
  2. _builder/blocks/{block-type}.twig

  Each block receives block, context (as a list) and transformKey.
#}
{% set contexts = (context ?? null) is iterable ? context : [context ?? null] %}
{% set contexts = contexts|filter %}

{% for block in blocks %}
    {% set type = block.type|kebab %}

    {% include contexts|map(name => '_builder/blocks/' ~ name ~ '/' ~ type)|merge(['_builder/blocks/' ~ type]) with {
        block: block,
        context: contexts,
        transformKey: transformKey ?? null,
    } only %}
{% endfor %}
