{# Reads any entry for a card: its URL, title and entry type. Add _builder/cards/{entry-type}.twig to read a type's own fields. #}
{% set entry = entry ?? null %}
{% set kind = kind ?? 'content' %}

{% if entry %}
    {% if craft.app.config.general.devMode %}
        <!-- Card: _builder/cards/default. Add _builder/cards/{{ entry.type.handle|kebab }}.twig to read this entry type's own fields. -->
    {% endif %}

    {% include '_components/cards/' ~ kind with {
        url: entry.url,
        title: entry.title,
        eyebrow: entry.type.name,
        headingLevel: headingLevel ?? 'h3',
        transformKey: transformKey ?? null,
        aspectRatio: aspectRatio ?? null,
    } only %}
{% endif %}
