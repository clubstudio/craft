{% import '_macros/classes' as classes %}

{% set width = block.contentWidth.value ?? 'full-width' %}
{% set capped = width in ['medium', 'narrow'] %}

<div{% if width != 'full-bleed' %} class="px-gutter"{% endif %}>
    <div{% if capped %} class="{{ classes.contentMaxWidth(width) }} {{ classes.horizontalAlignment(block.horizontalAlignment.value ?? 'center') }}"{% endif %}>
        {% block content %}
            <p>Default Container Content</p>
        {% endblock %}
    </div>
</div>
