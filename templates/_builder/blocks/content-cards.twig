{#
  Content Cards Block
  
  Grid of content cards with optional header text.
#}
{% import '_macros/transforms' as transforms %}

{% set transformKey = transforms.buildKey([transformKey, 'content-cards']) %}
{% set textContent = block.textContent.eagerly().all() %}
{% set cards = block.contentCards.eagerly().all() %}

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {% if textContent|length %}
        <div class="space-y-6">
            {% include '_builder/builder' with {
                context: 'columns/header',
                blocks: textContent,
            } only %}
        </div>
    {% endif %}

    {% for card in cards %}
        {% set entry = card.entry.eagerly().one() %}
        {% if entry %}
            {% include [
                '_builder/cards/' ~ entry.type|kebab,
                '_builder/cards/default',
            ] with {
                entry: entry,
                kind: 'content',
                transformKey: transformKey,
            } only %}
        {% endif %}
    {% endfor %}
</div>
