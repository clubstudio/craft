<article>
    <a href="{{ entry.url }}" class="flex flex-col justify-between h-full" aria-labelledby="card-title-{{ entry.id }}">
        <div class="mb-2">{{ entry.type.name }}</div>
        {% if craft.app.config.general.devMode %}
            <div class="text-sm text-gray-500">
                Create a template in <code class="text-xs">_builder/blocks/content-cards/{{ entry.type|kebab }}</code> to customise this card.
            </div>
        {% endif %}
        <h3 id="card-title-{{ entry.id }}">{{ entry.title }}</h3>
    </a>
</article>
