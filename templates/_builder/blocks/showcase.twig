{#
  Showcase Block
  
  Displays featured entries in a grid layout.
  Builds transform key for nested images: {parent}:showcase
#}
{% import '_macros/transforms' as transforms %}

{% set featuredEntries = block.entries.eagerly().all() %}
{% set links = block.links.eagerly().all()|map(link => {
    url: link.hyperlink.url ?? null,
    text: link.hyperlink.label ?? null,
    theme: link.linkStyle.value ?? 'primary',
    target: link.hyperlink.target ?? null,
    rel: link.hyperlink.rel ?? null,
    ariaLabel: link.hyperlink.ariaLabel ?? null,
}) %}
{% set transformKey = transforms.buildKey([transformKey, 'showcase']) %}

{% if featuredEntries|length %}
    <div class="
        grid grid-cols-1 lg:grid-cols-2
        gap-6
    ">
        {% for featuredEntry in featuredEntries %}
            <div class="basis-1/2 flex flex-col">
                {% include [
                    '_builder/cards/' ~ featuredEntry.type|kebab,
                    '_builder/cards/default',
                ] with {
                    entry: featuredEntry,
                    kind: 'showcase',
                    transformKey: transformKey,
                    aspectRatio: loop.first ? 'square' : 'photo-portrait',
                } only %}

                {% if loop.first and links|length %}
                    <div class="mt-auto pt-12">
                        {% include '_components/links' with { links: links } only %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}
