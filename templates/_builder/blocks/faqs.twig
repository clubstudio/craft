{# FAQs: questions and answers, picked from the FAQs channel or written in place, with FAQPage schema. #}
{% import '_macros/transforms' as transforms %}

{% set faqs = [] %}

{% for faq in block.faqs.eagerly().all() %}
    {% if faq.type == 'faqEntry' %}
        {% set faqEntry = faq.faqEntry.eagerly().one() %}
        {% set faqs = faqs|merge([{ question: faqEntry.title, answer: faqEntry.answer }]) %}
    {% else %}
        {% set faqs = faqs|merge([{ question: faq.title, answer: faq.answer }]) %}
    {% endif %}
{% endfor %}

{% set content = block.content.eagerly().all() %}

<div class="
    grid grid-cols-1 lg:grid-cols-[1fr_2fr]
    gap-6
">
    {% if content|length %}
        <div class="space-y-4 mb-6 flex flex-col h-full">
            {% include '_builder/builder' with {
                context: 'faqs',
                blocks: content,
                transformKey: transforms.buildKey([transformKey, 'faqs']),
            } only %}
        </div>
    {% endif %}

    {% if faqs|length %}
        <div class="divide-y -my-6">
            {% for faq in faqs %}
                <details class="py-6 group">
                    <summary class="list-none cursor-pointer">
                        {{ faq.question }}
                    </summary>
                    <div class="pt-6 body-copy">
                        {{ faq.answer }}
                    </div>
                </details>
            {% endfor %}
        </div>
    {% endif %}
</div>

{# A page gets one FAQPage, so each FAQs block adds its questions to the one already there. #}
{% if faqs|length %}
    {% set questions = faqs|map(faq => {
        'type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
            'type': 'Answer',
            'text': faq.answer|striptags,
        },
    }) %}

    {% do seomatic.jsonLd.create({
        'type': 'FAQPage',
        'key': 'faqPage',
        'mainEntity': (seomatic.jsonLd.get('faqPage').mainEntity ?? [])|merge(questions),
    }) %}
{% endif %}
