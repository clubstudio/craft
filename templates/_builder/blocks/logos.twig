{# Logos: a row of client or partner logos, each optionally linked. #}
{% include '_components/logos' with {
    logos: block.logos.eagerly().all()|map(logo => {
        name: logo.title,
        image: logo.image.eagerly().one(),
        url: logo.hyperlink.url ?? null,
        target: logo.hyperlink.target ?? null,
        rel: logo.hyperlink.rel ?? null,
        ariaLabel: logo.hyperlink.ariaLabel ?? null,
        download: (logo.hyperlink.download ?? false) ? (logo.hyperlink.filename ?: true) : null,
        id: logo.hyperlink.id ?? null,
    }),
} only %}
