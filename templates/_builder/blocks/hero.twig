{# Hero: the opening text elements beside an optional image, which uses the hero transform key. #}
{% set image = block.image.eagerly().one() %}

<section class="relative">
    {% embed '_components/layout/container' with { image: image, block: block } only %}
        {% block content %}
            {% embed '_components/layout/split' with { mediaPosition: 'right', image: image, block: block } only %}
                {% block media %}
                    {% if image %}
                        <figure aria-hidden="true">
                            {% include '_components/image' with {
                                image: image,
                                transformKey: 'hero',
                                loading: 'eager',
                                aspectRatio: 'photo',
                                class: 'w-full h-full object-cover',
                                attributes: {
                                    fetchpriority: 'high',
                                },
                            } only %}
                        </figure>
                    {% endif %}
                {% endblock %}

                {% block content %}
                    <div class="space-y-6">
                        {% include '_builder/builder' with {
                            context: 'hero',
                            blocks: block.content.eagerly().all(),
                            transformKey: 'hero',
                        } only %}
                    </div>
                {% endblock %}
            {% endembed %}
        {% endblock %}
    {% endembed %}
</section>
