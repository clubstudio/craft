{# Image Inline: a small image that sits in a line of text elements, such as an avatar or a badge. #}
{% set image = block.image.eagerly().one() %}

{% if image %}
    <div class="inline-block max-w-24 -ml-2 mb-1">
        {% include '_components/image' with {
            image: image,
            transformKey: 'image-inline',
            aspectRatio: 'auto',
        } only %}
    </div>
{% endif %}
