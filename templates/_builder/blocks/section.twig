{#
  Section Block

  Wraps content in a section with padding and a content width, and passes that width to the blocks inside it as
  contentWidth.
  Builds transform key for nested images: section:{contentWidth}

  Examples:
  - section:full-width
  - section:narrow
  - section:full-width:columns:2 (when columns nested inside)
#}
{% import '_macros/transforms' as transforms %}

{% set contentWidth = block.contentWidth.value ?? 'full-width' %}
{% set transformKey = transforms.buildKey([transformKey, 'section', contentWidth]) %}

{% embed '_builder/section' with { block: block, transformKey: transformKey, contentWidth: contentWidth } only %}
    {% block content %}
        {% embed '_components/layout/container' with {
            width: contentWidth,
            alignment: block.horizontalAlignment.value ?? 'center',
            block: block,
            transformKey: transformKey,
            contentWidth: contentWidth,
        } only %}
            {% block content %}
                {% include '_builder/builder' with {
                    context: 'section',
                    blocks: block.sectionContent.eagerly().all(),
                    transformKey: transformKey,
                    contentWidth: contentWidth,
                } only %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
