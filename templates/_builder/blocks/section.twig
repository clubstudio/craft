{#
  Section Block
  
  Wraps content in a section with padding and a content width.
  Builds transform key for nested images: section:{contentWidth}

  Examples:
  - section:full-width
  - section:narrow
  - section:full-width:columns:2 (when columns nested inside)
#}
{% import '_macros/transforms' as transforms %}

{% set transformKey = transforms.buildKey([transformKey, 'section', block.contentWidth.value ?? 'full-width']) %}

{% embed '_builder/section' with { block: block, transformKey: transformKey } only %}
    {% block content %}
        {% embed '_builder/container' with { block: block, transformKey: transformKey } only %}
            {% block content %}
                {% include '_builder/builder' with {
                    context: 'section',
                    blocks: block.sectionContent.eagerly().all(),
                    transformKey: transformKey,
                } only %}
            {% endblock %}
        {% endembed %}
    {% endblock %}
{% endembed %}
