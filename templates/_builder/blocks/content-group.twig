{# Content Group: a stack of small blocks (eyebrow, heading, paragraph, links and more), aligned left, centre or right. #}
{% import '_macros/classes' as classes %}

<div class="space-y-6 {{ classes.textAlignment(block.textAlignment.value ?? 'left') }}">
    {% include '_builder/builder' with {
        context: 'content-group',
        blocks: block.content.eagerly().all(),
        transformKey: transformKey,
    } only %}
</div>
