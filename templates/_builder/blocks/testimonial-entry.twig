{# Testimonial Entry: a quote from the Testimonials channel with the person, company and photo. #}
{% set testimonial = block.testimonialEntry.eagerly().one() %}

{% if testimonial %}
    {% include '_components/testimonial' with {
        quote: testimonial.testimonial,
        person: testimonial.person,
        company: testimonial.company,
        image: testimonial.image.eagerly().one(),
    } only %}
{% endif %}
