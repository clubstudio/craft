{# Step: one step in a Steps block, made of text elements. It renders the <li> for Steps' <ol>. #}
<li class="space-y-4 flex flex-col h-full">
    {% include '_builder/builder' with {
        context: context,
        blocks: block.textContent.eagerly().all(),
        transformKey: transformKey,
    } only %}
</li>

