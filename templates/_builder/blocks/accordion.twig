<div class="divide-y">
    {% for item in block.accordionItems.eagerly().all() %}
        <details class="py-4 group">
            <summary class="cursor-pointer list-none">
                {{ item.title }}
            </summary>
            <div class="pt-4 body-copy">
                {{ item.body }}
            </div>
        </details>
    {% endfor %}
</div>
