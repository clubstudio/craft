{# Video: a video file with optional caption tracks. #}
{% if block.videoUrl %}
    {% include '_components/video' with {
        url: block.videoUrl,
        aspectRatio: block.aspectRatio.value,
        title: block.title,
        tracks: block.videoTracks.eagerly().all()|map(track => {
            label: track.title,
            src: track.vttFile.eagerly().one().url ?? null,
        }),
    } only %}
{% endif %}
